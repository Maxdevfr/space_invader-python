import pyxel

pyxel.init(160, 120)
pyxel.load("ressources.pyxres")  # optionnel

# Charger un son WAV
pyxel.sound(0).load("son.wav")

def update():
    if pyxel.btnp(pyxel.KEY_SPACE):
        pyxel.play(0, 0)  # canal 0, son 0

def draw():
    pyxel.cls(0)
    pyxel.text(10, 10, "Appuie sur ESPACE", 7)

pyxel.run(update, draw)
